{
  "name": "bemyrecipe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run catalog:build && vite",
    "build": "npm run catalog:build && tsc -b && vite build && npm --prefix functions run build",
    "preview": "vite preview",
    "catalog:build": "node --import tsx scripts/build-catalog.ts",
    "catalog:validate": "node --import tsx scripts/validate-recipes.ts",
    "catalog:sync": "node --import tsx scripts/sync-catalog.ts",
    "rules:test": "node --import tsx scripts/test-rules.ts",
    "versions:test": "node --import tsx scripts/test-versioning.ts",
    "profiles:test": "node --import tsx scripts/test-profile-naming.ts",
    "thermal:test": "node --import tsx scripts/test-flash-thermal.ts",
    "routes:test": "node --import tsx scripts/test-catalog-route.ts",
    "deploy": "npm run build && firebase deploy",
    "deploy:public": "npm run build && firebase deploy --only hosting,firestore",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "emulators": "npm run build && firebase emulators:start --project bemyrecipe"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.2.1",
    "lucide-react": "^1.34.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "dotenv": "^17.2.1",
    "firebase-tools": "^15.28.1",
    "gray-matter": "^4.0.3",
    "tsx": "^4.20.5",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "yaml": "^2.8.1"
  }
}
